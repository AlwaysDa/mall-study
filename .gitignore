.workbuddy/

# ===== 临时文件 / 日志 =====
*.log
.build.log
.envcheck*
.fmtcheck*
.gitcheck*
.gitrun*
.treecheck*
.mdcheck*

# ===== 压缩包（本地导出的副本，源码已在 mall/ 中）=====
mall.zip
*.zip

# ===== IDE =====
.idea/
*.iml
*.ipr
*.iws
.vscode/

# ===== 构建产物（mall/.gitignore 里也有一份，这里兜底）=====
target/
build/
out/

# ===== 操作系统 =====
Thumbs.db
Desktop.ini
.DS_Store
